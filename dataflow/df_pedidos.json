{
	"name": "df_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_pedido = iif(like(fecha_pedido, '%/%'), toDate(fecha_pedido, 'dd/MM/yyyy'), toDate(fecha_pedido, 'yyyy-MM-dd')),",
				"          hora_pedido = toTimestamp(hora_pedido, 'HH:mm:ss'),",
				"          promocion_id = iif(isNull(promocion_id) || trim(promocion_id) == '', 'SIN_PROMOCION', trim(promocion_id)),",
				"          canal = initCap(trim(canal)),",
				"          cliente_id = trim(cliente_id),",
				"          sucursal_id = trim(sucursal_id)) ~> derivedColumn1",
				"derivedColumn1 derive(subtotal = toDecimal(replace(toString(subtotal), ',', '.'), 12, 2),",
				"          costo_delivery = toDecimal(replace(toString(costo_delivery), ',', '.'), 12, 2),",
				"          descuento = toDecimal(replace(toString(descuento), ',', '.'), 12, 2),",
				"          impuesto = toDecimal(replace(toString(impuesto), ',', '.'), 12, 2),",
				"          total_pedido = toDecimal(replace(toString(total_pedido), ',', '.'), 12, 2)) ~> derivedColumn2",
				"derivedColumn2 split(toDecimal(total_pedido) >= 0 && pedido_id != 'PED999999',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pedido_id as string,",
				"          fecha_pedido as date,",
				"          hora_pedido as timestamp,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as decimal(12,2),",
				"          costo_delivery as decimal(12,2),",
				"          descuento as decimal(12,2),",
				"          impuesto as decimal(12,2),",
				"          total_pedido as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          pedido_id,",
				"          fecha_pedido,",
				"          hora_pedido,",
				"          cliente_id,",
				"          sucursal_id,",
				"          canal,",
				"          tipo_servicio,",
				"          estado_pedido,",
				"          promocion_id,",
				"          subtotal,",
				"          costo_delivery,",
				"          descuento,",
				"          impuesto,",
				"          total_pedido",
				"     )) ~> sink1"
			]
		}
	}
}