{
	"name": "df_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sucursales",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(capacidad_mesas = iif(toInteger(capacidad_mesas) < 0, abs(toInteger(capacidad_mesas)), toInteger(capacidad_mesas)),",
				"          ciudad = iif(isNull(ciudad) || trim(ciudad) == '', 'Desconocida', trim(ciudad)),",
				"          nombre_sucursal = iif(isNull(nombre_sucursal) || trim(nombre_sucursal) == '', 'Sucursal Sin Nombre', trim(nombre_sucursal)),",
				"          tiene_delivery = initCap(trim(tiene_delivery)),",
				"          sucursal_id = trim(sucursal_id),",
				"          restaurante_id = trim(restaurante_id)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(sucursal_id) && trim(sucursal_id) != '' && !isNull(restaurante_id) && trim(restaurante_id) != '',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(sucursal_id),",
				"     restaurante_id = first(restaurante_id),",
				"          nombre_sucursal = first(nombre_sucursal),",
				"          ciudad = first(ciudad),",
				"          zona = first(zona),",
				"          direccion = first(direccion),",
				"          capacidad_mesas = first(capacidad_mesas),",
				"          tiene_delivery = first(tiene_delivery)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as integer,",
				"          tiene_delivery as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sucursal_id,",
				"          restaurante_id,",
				"          nombre_sucursal,",
				"          ciudad,",
				"          zona,",
				"          direccion,",
				"          capacidad_mesas,",
				"          tiene_delivery",
				"     )) ~> sink1"
			]
		}
	}
}